# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# setlist.fm API key — get one at https://api.setlist.fm/docs/1.0/index.html
# Server-side only (no NEXT_PUBLIC_ prefix): use it in Server Components or
# route handlers, e.g. headers: { "x-api-key": process.env.SETLISTFM_API_KEY }
SETLISTFM_API_KEY=
