# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.
# For deployments, add the same variables in Vercel:
# Project → Settings → Environment Variables (Production + Preview).

# --- setlist.fm ------------------------------------------------------
# API key from https://api.setlist.fm/docs/1.0/index.html
# Powers live setlists on show pages and the /import profile importer.
SETLISTFM_API_KEY=

# --- Database (Neon Postgres) ---------------------------------------
# Create a free database at https://neon.tech (or via the Vercel
# Marketplace) and paste its connection string. Then run:
#   npm run db:push
# Without this, the app runs in read-only demo mode.
DATABASE_URL=

# --- Auth.js -----------------------------------------------------------
# Auth needs DATABASE_URL + AUTH_SECRET. Username/password accounts work
# with just these; Google sign-in additionally needs the two AUTH_GOOGLE_*
# vars at the bottom of this file.
# Generate AUTH_SECRET with:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# --- Invite-only sign-up (optional) -----------------------------------
# New accounts require this code (case-insensitive). Handy while onboarding
# testers. Defaults to BUDDY if unset. Google sign-in is limited to
# existing accounts while this is in effect.
SIGNUP_INVITE_CODE=BUDDY

# --- Cloudinary uploads (optional) ------------------------------------
# Enables in-browser file uploads on the add-poster/ephemera/photo forms.
# Without these, the forms still work via paste-an-image-URL.
# Cloud name: Cloudinary dashboard, top left. Upload preset: Settings →
# Upload → Add upload preset → Signing mode: "Unsigned" → copy its name.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# --- Email notifications (optional) -----------------------------------
# Resend key from https://resend.com — used to email print owners when a
# collector expresses interest on the Trading Post. Without a verified
# domain, Resend's sandbox sender only delivers to your own account email.
RESEND_API_KEY=
# Optional verified sender, e.g. "Concert Collect <notify@concertcollect.com>"
RESEND_FROM=

# --- Admin (/admin) -----------------------------------------------------
# Password for the owner dashboard (signups + contribution activity).
# Page is disabled until this is set.
ADMIN_PASSWORD=

# --- Show Enrichment Engine (all optional) -----------------------------
# Each provider lights up when its keys exist; without them the Enrich
# Show UI marks that provider "not configured" and skips it. setlist.fm
# and MusicBrainz work with no extra keys (setlist.fm reuses
# SETLISTFM_API_KEY above; MusicBrainz is open).
#
# Ticketmaster Discovery API — https://developer.ticketmaster.com
TICKETMASTER_API_KEY=
# YouTube Data API v3 — Google Cloud console → enable YouTube Data API
YOUTUBE_API_KEY=
# Google Programmable Search (image mode) — https://programmablesearch.google.com
# Create an engine with "Search the entire web" + Image search ON; the
# key comes from the Custom Search JSON API in Google Cloud.
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=
# eBay Browse API (production keyset) — https://developer.ebay.com
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Auto-accept threshold (0-100) for low-risk structured fields. Default 90.
# ENRICH_AUTO_ACCEPT=90

# Google OAuth client — optional; username/password login works without it.
# (https://console.cloud.google.com/apis/credentials):
#   - Application type: Web application
#   - Authorized redirect URI (local):  http://localhost:3000/api/auth/callback/google
#   - Authorized redirect URI (prod):   https://concertcollect.com/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
